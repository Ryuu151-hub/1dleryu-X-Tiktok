# Copy to Vercel → Project Settings → Environment Variables

# true = show maintenance page (default)
MAINTENANCE_MODE=true

# Optional custom message
MAINTENANCE_MESSAGE=This website is in maintenance mode. Please check back later.

# TikWM API
TIKWM_API_KEY=your_key_here
# Paid: https://api.tikwmapi.com
# Free public: https://tikwm.com/api
TIKWM_BASE_URL=https://api.tikwmapi.com

# Optional label
ENGINE_VERSION=4.9
